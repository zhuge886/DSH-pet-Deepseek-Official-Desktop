  "patches": [
    {
      "name": "asset-root",
      "file": "lib/index.js",
      "reason": "素材根指向仓库 dsh-pet/assets，避免 54MB webm 重复入库",
      "search": "const PACKAGE_ROOT = resolve(fileURLToPath(new URL(\"..\", import.meta.url)));",
      "replace": "const PACKAGE_ROOT = resolve(fileURLToPath(new URL(\"../../../dsh-pet/\", import.meta.url)));"
    },
    {
      "name": "lazy-download-loaders",
      "file": "lib/index.js",
      "reason": "Electron 下载依赖改为按需加载",
      "search": "async function ensureElectronDownload(options = {}) {",
      "replace": "（前置 loadElectronDownloader / loadZipExtractor）"
    },
    {
      "name": "drop-static-electron-import",
      "file": "lib/index.js",
      "reason": "顶层 @electron/get import 会让 link: 安装缺依赖时整个插件激活失败",
      "search": "import { downloadArtifact } from \"@electron/get\";\n",
      "replace": ""
    },
    {
      "name": "drop-dynamic-zip-import",
      "file": "lib/index.js",
      "reason": "解压器改为 loadZipExtractor()，与下载器一起做缺依赖提示",
      "search": "\t\t\tconst { default: extract } = await import(\"@electron-internal/extract-zip\");\n",
      "replace": ""
    },
    {
      "name": "drag-follow-stiffness-client",
      "file": "lib/client.js",
      "reason": "拖拽跟随弹簧 200/30 → 800/50：滞后 0.15v → 0.0625v，浏览器 overlay 拖拽更跟手（不改抛掷物理）",
      "search": "const SPRING_K = 200;\nconst SPRING_C = 30;",
      "replace": "const SPRING_K = 800;\nconst SPRING_C = 50;"
    },
    {
      "name": "drag-follow-stiffness-desktop",
      "file": "runtime/electron-helper/shared-core.js",
      "reason": "同上，桌面透明小窗拖拽跟随更跟手",
      "search": "const SPRING_K = 200;\nconst SPRING_C = 30;",
      "replace": "const SPRING_K = 800;\nconst SPRING_C = 50;"
    }
  ],
